// ==========================================
// ACADEMIC STRUCTURE & ENROLLMENT DOMAIN
// ==========================================

model AcademicYear {
  id                  String                      @id @default(uuid()) @db.Uuid

  instituteId         String                      @db.Uuid

  name                String
  code                String

  startDate           DateTime
  endDate             DateTime

  isCurrent           Boolean                     @default(false)

  status              RecordStatus                @default(ACTIVE)

  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  institute           Institute                   @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  enrollments         StudentAcademicEnrollment[]
  classGroups         ClassGroup[]
  exams               Exam[]
  assessments         Assessment[]
  markingSchemeAssignments MarkingSchemeAssignment[]
  attendancePolicies  AttendancePolicy[]
  attendanceCalendars AttendanceCalendar[]
  attendanceSessions  AttendanceSession[]
  studentResults      StudentResult[]

  @@unique([instituteId, code])
  @@map("academic_years")
  @@index([instituteId, isCurrent])
}

model Program {
  id                  String                      @id @default(uuid()) @db.Uuid

  instituteId         String                      @db.Uuid

  name                String
  code                String
  description         String?

  status              RecordStatus                @default(ACTIVE)

  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  institute           Institute                   @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  levels              Level[]
  classGroups         ClassGroup[]
  academicEnrollments StudentAcademicEnrollment[]
  exams               Exam[]
  markingSchemeAssignments MarkingSchemeAssignment[]
  attendanceCalendars AttendanceCalendar[]

  @@unique([instituteId, code])
  @@map("programs")
  @@index([instituteId])
}

model Level {
  id          String       @id @default(uuid()) @db.Uuid

  instituteId String       @db.Uuid
  programId   String       @db.Uuid

  name        String
  code        String
  sortOrder   Int          @default(0)

  status      RecordStatus @default(ACTIVE)

  institute   Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  program     Program      @relation(fields: [programId], references: [id], onDelete: Cascade)

  classGroups ClassGroup[]
  markingSchemeAssignments MarkingSchemeAssignment[]

  @@unique([programId, code])
  @@map("levels")
  @@index([instituteId])
  @@index([programId, sortOrder])
}

model ClassGroup {
  id                  String                      @id @default(uuid()) @db.Uuid

  instituteId         String                      @db.Uuid
  academicYearId      String                      @db.Uuid
  programId           String                      @db.Uuid
  levelId             String?                     @db.Uuid

  name                String
  code                String

  type                String                      @default("CLASS")
  capacity            Int?

  status              RecordStatus                @default(ACTIVE)

  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  institute           Institute                   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear                @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  program             Program                     @relation(fields: [programId], references: [id], onDelete: Cascade)
  level               Level?                      @relation(fields: [levelId], references: [id], onDelete: SetNull)

  sections            Section[]
  academicEnrollments StudentAcademicEnrollment[]
  teacherAssignments  ClassTeacher[]
  routines            ClassRoutine[]
  exams               Exam[]
  assessments         Assessment[]
  markingSchemeAssignments MarkingSchemeAssignment[]
  attendancePolicies  AttendancePolicy[]
  attendanceCalendars AttendanceCalendar[]
  attendanceSessions  AttendanceSession[]
  studentResults      StudentResult[]

  @@unique([academicYearId, code])
  @@map("class_groups")
  @@index([instituteId])
  @@index([academicYearId])
}

model Section {
  id                  String                      @id @default(uuid()) @db.Uuid

  classGroupId        String                      @db.Uuid

  name                String
  code                String

  capacity            Int?

  status              RecordStatus                @default(ACTIVE)

  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  classGroup          ClassGroup                  @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  academicEnrollments StudentAcademicEnrollment[]
  routines            ClassRoutine[]
  exams               Exam[]
  assessments         Assessment[]
  markingSchemeAssignments MarkingSchemeAssignment[]
  attendanceCalendars AttendanceCalendar[]
  attendanceSessions  AttendanceSession[]
  studentResults      StudentResult[]

  @@unique([classGroupId, code])
  @@map("sections")
  @@index([classGroupId])
}

model Subject {
  id                  String              @id @default(uuid()) @db.Uuid

  instituteId         String              @db.Uuid

  name                String
  code                String
  description         String?

  status              RecordStatus        @default(ACTIVE)

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  institute           Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  courses             Course[]
  classRoutines       ClassRoutine[]
  assessments         Assessment[]
  markingSchemeAssignments MarkingSchemeAssignment[]
  attendanceCalendars AttendanceCalendar[]
  attendanceSessions  AttendanceSession[]
  studentResults      StudentResult[]

  @@unique([instituteId, code])
  @@map("subjects")
  @@index([instituteId])
}

model StudentAcademicEnrollment {
  id             String           @id @default(uuid()) @db.Uuid

  studentId      String           @db.Uuid
  academicYearId String           @db.Uuid

  programId      String           @db.Uuid
  classGroupId   String           @db.Uuid
  sectionId      String?          @db.Uuid

  rollNumber     String?

  admissionDate  DateTime?
  startDate      DateTime?
  endDate        DateTime?

  status         EnrollmentStatus @default(ACTIVE)

  promotedFromId String?          @db.Uuid

  metadata       Json?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  program        Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  classGroup     ClassGroup       @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  section        Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@map("student_academic_enrollments")
  @@index([studentId, academicYearId])
  @@index([classGroupId, sectionId])
  @@index([status])
}

model ClassTeacher {
  classGroupId String         @db.Uuid
  teacherId    String         @db.Uuid

  role         String?

  classGroup   ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classGroupId, teacherId])
  @@map("class_teachers")
}
