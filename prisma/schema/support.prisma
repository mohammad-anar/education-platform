// ==========================================
// SUPPORT SYSTEM & LIVE HELP SESSIONS
// ==========================================

model InstituteSupportSetting {
  id                   String    @id @default(uuid()) @db.Uuid
  instituteId          String    @unique @db.Uuid

  isOpen               Boolean   @default(true)
  openHours            Json?
  timezone             String    @default("UTC")
  allowLiveSession     Boolean   @default(true)
  defaultProvider      String    @default("GOOGLE_MEET")
  allowedMeetingDomains String[] @default(["zoom.us", "meet.google.com"])

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  institute            Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@map("institute_support_settings")
  @@index([instituteId])
}

model SupportCategory {
  id          String        @id @default(uuid()) @db.Uuid
  instituteId String        @db.Uuid

  name        String
  code        String
  description String?

  status      RecordStatus  @default(ACTIVE)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  institute   Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  tickets     SupportTicket[]

  @@unique([instituteId, code])
  @@index([instituteId])
  @@map("support_categories")
}

model SupportTicket {
  id               String               @id @default(uuid()) @db.Uuid
  instituteId      String               @db.Uuid

  ticketNumber     String
  studentId        String               @db.Uuid
  categoryId       String?              @db.Uuid
  assignedToUserId String?              @db.Uuid

  subject          String
  description      String
  priority         TicketPriority       @default(MEDIUM)
  status           TicketStatus         @default(OPEN)

  resolvedAt       DateTime?
  closedAt         DateTime?

  rating           Int?
  ratingFeedback   String?
  metadata         Json?

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  institute        Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student          Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category         SupportCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo       User?                @relation("AssignedSupportTickets", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  messages         SupportTicketMessage[]
  sessions         SupportSession[]

  @@unique([instituteId, ticketNumber])
  @@index([instituteId, status, createdAt])
  @@index([studentId, createdAt])
  @@index([assignedToUserId, status])
  @@index([instituteId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id             String        @id @default(uuid()) @db.Uuid
  instituteId    String        @db.Uuid
  ticketId       String        @db.Uuid
  senderId       String        @db.Uuid

  message        String
  isInternalNote Boolean       @default(false)
  attachments    Json?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  institute      Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([instituteId])
  @@map("support_ticket_messages")
}

model SupportAvailabilitySlot {
  id          String         @id @default(uuid()) @db.Uuid
  instituteId String         @db.Uuid
  userId      String         @db.Uuid

  startTime   DateTime
  endTime     DateTime

  isBooked    Boolean        @default(false)
  status      SlotStatus     @default(AVAILABLE)
  version     Int            @default(0)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  institute   Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     SupportSession?

  @@index([instituteId, isBooked, startTime])
  @@index([instituteId, userId, startTime])
  @@map("support_availability_slots")
}

model SupportSession {
  id              String               @id @default(uuid()) @db.Uuid
  instituteId     String               @db.Uuid
  ticketId        String               @db.Uuid
  slotId          String?              @unique @db.Uuid
  hostUserId      String               @db.Uuid
  studentId       String               @db.Uuid

  scheduledStart  DateTime
  scheduledEnd    DateTime

  meetingUrl      String?
  meetingProvider String?
  status          SupportSessionStatus @default(SCHEDULED)

  notes           String?
  cancelledReason String?
  confirmedAt     DateTime?
  completedAt     DateTime?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  institute       Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  ticket          SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  slot            SupportAvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  host            User                 @relation("HostedSupportSessions", fields: [hostUserId], references: [id], onDelete: Cascade)
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([instituteId, status, scheduledStart])
  @@index([ticketId])
  @@index([hostUserId, status])
  @@index([studentId, scheduledStart])
  @@index([instituteId])
  @@map("support_sessions")
}
