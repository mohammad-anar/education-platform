// ==========================================
// PEOPLE DOMAIN (STUDENT, TEACHER, STAFF, GUARDIAN)
// ==========================================

model Student {
  id                    String       @id @default(uuid()) @db.Uuid

  instituteId           String       @db.Uuid
  userId                String?      @unique @db.Uuid

  studentCode           String
  admissionNo           String?

  dateOfBirth           DateTime?
  gender                Gender?
  bloodGroup            String?

  admissionDate         DateTime?
  graduationDate        DateTime?

  status                RecordStatus @default(ACTIVE)
  statusReason          String?

  emergencyContactName  String?
  emergencyContactPhone String?

  // Step 5 Extended Profile Attributes
  nationality           String?
  religion              String?
  nationalId            String?
  birthCertificateNo    String?
  photoFileAssetId      String?      @db.Uuid
  presentAddress        Json?
  permanentAddress      Json?
  alternatePhone        String?
  previousSchool        String?
  fatherName            String?
  motherName            String?
  allergies             String?
  medicalConditions     String?
  language              String?
  notificationPrefs     Json?
  visibility            Json?

  metadata              Json?

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  // Relations
  institute             Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user                  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  photoFileAsset        FileAsset?   @relation("StudentPhotoAsset", fields: [photoFileAssetId], references: [id], onDelete: SetNull)

  guardians             StudentGuardian[]
  documents             StudentDocument[]

  // Academic & LMS Relations
  academicEnrollments    StudentAcademicEnrollment[]
  courseEnrollments      CourseEnrollment[]
  lessonProgress         LessonProgress[]
  learningAccessOverrides LearningItemAccessOverride[]

  // Assessment, Exam & Result Relations
  assignmentSubmissions AssignmentSubmission[]
  assessmentResults     AssessmentResult[]
  examMarks             ExamMark[]
  studentResults        StudentResult[]

  // Attendance & Certificates
  attendanceRecords     AttendanceRecord[]
  lessonNotes           LessonNote[]
  certificates          Certificate[]

  // Support System
  supportTickets        SupportTicket[]
  supportSessions       SupportSession[]

  @@unique([instituteId, studentCode])
  @@unique([instituteId, admissionNo])
  @@map("students")
  @@index([instituteId])
  @@index([status])
  @@index([studentCode])
}

model StudentDocument {
  id           String       @id @default(uuid()) @db.Uuid

  instituteId  String       @db.Uuid
  studentId    String       @db.Uuid

  title        String
  documentType String?

  fileAssetId  String?      @db.Uuid

  verified     Boolean      @default(false)
  verifiedById String?      @db.Uuid
  verifiedAt   DateTime?

  metadata     Json?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  institute    Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset?   @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  verifiedBy   User?        @relation("StudentDocVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([instituteId, studentId])
  @@index([studentId])
  @@map("student_documents")
}

model Guardian {
  id          String            @id @default(uuid()) @db.Uuid

  instituteId String            @db.Uuid
  userId      String?           @unique @db.Uuid

  name        String?
  phone       String?
  email       String?
  occupation  String?
  nationalId  String?

  status      RecordStatus      @default(ACTIVE)

  metadata    Json?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  institute   Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  students    StudentGuardian[]

  @@map("guardians")
  @@index([instituteId])
}

model StudentGuardian {
  id              String   @id @default(uuid()) @db.Uuid

  studentId       String   @db.Uuid
  guardianId      String   @db.Uuid

  relationship    String
  isPrimary       Boolean  @default(false)

  canViewAcademic Boolean  @default(true)
  canViewFinance  Boolean  @default(false)

  createdAt       DateTime @default(now())

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian        Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@map("student_guardians")
  @@index([studentId])
  @@index([guardianId])
}

model TeacherProfile {
  id               String           @id @default(uuid()) @db.Uuid

  instituteId      String           @db.Uuid
  userId           String           @unique @db.Uuid

  employeeCode     String?

  designation      String?
  qualification    String?
  specialization   String?
  experienceYears  Int?

  joiningDate      DateTime?
  leavingDate      DateTime?

  employmentStatus EmploymentStatus @default(ACTIVE)

  // Step 5 Extended Profile Attributes
  bio                    String?
  headline               String?
  photoFileAssetId       String?           @db.Uuid
  languages              String[]          @default([])
  officePhone            String?
  publicEmail            String?
  officeRoom             String?
  officeHours            Json?
  socialLinks            Json?
  nationalId             String?
  address                Json?
  acceptsSupportSessions Boolean           @default(false)
  defaultMeetingUrl      String?
  language               String?
  notificationPrefs      Json?
  visibility             Json?

  metadata         Json?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  institute        Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoFileAsset   FileAsset?       @relation("TeacherPhotoAsset", fields: [photoFileAssetId], references: [id], onDelete: SetNull)

  qualifications   TeacherQualification[]

  courseAssignments CourseTeacher[]
  classAssignments  ClassTeacher[]
  classRoutines     ClassRoutine[]
  liveClasses       LiveClass[]

  attendanceCalendars   AttendanceCalendar[]
  calendarRules         AttendanceCalendarRule[]
  attendanceSessions    AttendanceSession[]

  @@unique([instituteId, employeeCode])
  @@map("teacher_profiles")
  @@index([instituteId, employmentStatus])
}

model TeacherQualification {
  id               String         @id @default(uuid()) @db.Uuid

  instituteId      String         @db.Uuid
  teacherProfileId String         @db.Uuid

  degree           String
  fieldOfStudy     String?
  institution      String
  passingYear      Int?
  grade            String?

  fileAssetId      String?        @db.Uuid

  verified         Boolean        @default(false)
  verifiedById     String?        @db.Uuid
  verifiedAt       DateTime?

  metadata         Json?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  institute        Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  fileAsset        FileAsset?     @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  verifiedBy       User?          @relation("TeacherQualVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([instituteId, teacherProfileId])
  @@index([teacherProfileId])
  @@map("teacher_qualifications")
}

model StaffProfile {
  id               String           @id @default(uuid()) @db.Uuid

  instituteId      String           @db.Uuid
  userId           String           @unique @db.Uuid

  employeeCode     String?

  departmentId     String?          @db.Uuid
  designationId    String?          @db.Uuid

  joiningDate      DateTime?
  leavingDate      DateTime?

  employmentStatus EmploymentStatus @default(ACTIVE)

  // Step 5 Extended Profile Attributes
  staffType              StaffType        @default(OTHER)
  phone                  String?
  address                Json?
  emergencyContact       Json?
  acceptsSupportSessions Boolean          @default(false)
  defaultMeetingUrl      String?
  visibility             Json?
  photoFileAssetId       String?          @db.Uuid

  metadata         Json?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  institute        Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  photoFileAsset   FileAsset?       @relation("StaffPhotoAsset", fields: [photoFileAssetId], references: [id], onDelete: SetNull)

  documents        StaffDocument[]

  @@unique([instituteId, employeeCode])
  @@map("staff_profiles")
  @@index([instituteId, employmentStatus])
}

model StaffDocument {
  id             String       @id @default(uuid()) @db.Uuid

  instituteId    String       @db.Uuid
  staffProfileId String       @db.Uuid

  title          String
  documentType   String?

  fileAssetId    String?      @db.Uuid

  verified       Boolean      @default(false)
  verifiedById   String?      @db.Uuid
  verifiedAt     DateTime?

  metadata       Json?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  institute      Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  fileAsset      FileAsset?   @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  verifiedBy     User?        @relation("StaffDocVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([instituteId, staffProfileId])
  @@index([staffProfileId])
  @@map("staff_documents")
}

model Department {
  id            String         @id @default(uuid()) @db.Uuid

  instituteId   String         @db.Uuid
  name          String
  code          String
  status        RecordStatus   @default(ACTIVE)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  institute     Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  staffProfiles StaffProfile[]

  @@unique([instituteId, code])
  @@index([instituteId])
  @@map("departments")
}

model Designation {
  id            String         @id @default(uuid()) @db.Uuid

  instituteId   String         @db.Uuid
  name          String
  code          String
  status        RecordStatus   @default(ACTIVE)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  institute     Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  staffProfiles StaffProfile[]

  @@unique([instituteId, code])
  @@index([instituteId])
  @@map("designations")
}
