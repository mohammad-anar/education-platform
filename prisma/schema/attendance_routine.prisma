// ==========================================
// ATTENDANCE CALENDAR, SESSIONS, ROUTINES & LIVE CLASSES
// ==========================================

// ------------------------------------------
// 1. ATTENDANCE POLICY & CONFIGURATION
// ------------------------------------------

model AttendancePolicy {
  id                    String               @id @default(uuid()) @db.Uuid

  instituteId           String               @db.Uuid
  academicYearId        String?              @db.Uuid
  classGroupId          String?              @db.Uuid

  name                  String
  code                  String
  description           String?

  minRequiredPercentage Decimal              @default(75.00) @db.Decimal(5, 2)

  presentWeight         Decimal              @default(1.00) @db.Decimal(4, 2)
  lateWeight            Decimal              @default(0.75) @db.Decimal(4, 2)
  halfDayWeight         Decimal              @default(0.50) @db.Decimal(4, 2)
  excusedWeight         Decimal              @default(1.00) @db.Decimal(4, 2)

  lateCountToAbsent     Int?                 // e.g., 3 lates = 1 absent penalty

  status                RecordStatus         @default(ACTIVE)

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  institute             Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  academicYear          AcademicYear?        @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  classGroup            ClassGroup?          @relation(fields: [classGroupId], references: [id], onDelete: SetNull)

  calendars             AttendanceCalendar[]

  @@unique([instituteId, code])
  @@map("attendance_policies")
  @@index([instituteId])
}

// ------------------------------------------
// 2. ATTENDANCE CALENDAR & GENERATION RULES
// ------------------------------------------

model AttendanceCalendar {
  id             String                        @id @default(uuid()) @db.Uuid

  instituteId    String                        @db.Uuid
  academicYearId String?                       @db.Uuid
  programId      String?                       @db.Uuid
  classGroupId   String?                       @db.Uuid
  sectionId      String?                       @db.Uuid
  subjectId      String?                       @db.Uuid
  courseId       String?                       @db.Uuid
  teacherId      String?                       @db.Uuid
  policyId       String?                       @db.Uuid

  name           String
  code           String?

  startDate      DateTime
  endDate        DateTime

  timezone       String                        @default("Asia/Dhaka")
  isRecurring    Boolean                       @default(true)

  status         AttendanceCalendarStatus      @default(DRAFT)
  createdById    String?                       @db.Uuid

  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  institute      Institute                     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear?                 @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  program        Program?                      @relation(fields: [programId], references: [id], onDelete: SetNull)
  classGroup     ClassGroup?                   @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  section        Section?                      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject        Subject?                      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  course         Course?                       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacher        TeacherProfile?               @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  policy         AttendancePolicy?             @relation(fields: [policyId], references: [id], onDelete: SetNull)
  createdByUser  User?                         @relation("CalendarCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  rules          AttendanceCalendarRule[]
  exceptions     AttendanceCalendarException[]
  sessions       AttendanceSession[]

  @@map("attendance_calendars")
  @@index([instituteId, academicYearId])
  @@index([classGroupId, sectionId])
  @@index([status])
}

model AttendanceCalendarRule {
  id         String             @id @default(uuid()) @db.Uuid

  calendarId String             @db.Uuid

  dayOfWeek  Int                // 0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday, 6=Saturday

  startTime  DateTime?
  endTime    DateTime?

  teacherId  String?            @db.Uuid
  room       String?

  isActive   Boolean            @default(true)

  calendar   AttendanceCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  teacher    TeacherProfile?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@map("attendance_calendar_rules")
  @@index([calendarId, dayOfWeek])
}

model AttendanceCalendarException {
  id                   String                  @id @default(uuid()) @db.Uuid

  calendarId           String                  @db.Uuid

  date                 DateTime

  type                 AttendanceExceptionType // HOLIDAY, CANCELLED, RESCHEDULED, SPECIAL_CLASS, NO_CLASS
  reason               String?

  replacementDate      DateTime?
  replacementStartTime DateTime?
  replacementEndTime   DateTime?

  calendar             AttendanceCalendar      @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@map("attendance_calendar_exceptions")
  @@index([calendarId, type])
}

// ------------------------------------------
// 3. ATTENDANCE SESSIONS & STUDENT RECORDS
// ------------------------------------------

model AttendanceSession {
  id             String                  @id @default(uuid()) @db.Uuid

  instituteId    String                  @db.Uuid
  calendarId     String?                 @db.Uuid

  academicYearId String?                 @db.Uuid
  classGroupId   String?                 @db.Uuid
  sectionId      String?                 @db.Uuid
  subjectId      String?                 @db.Uuid
  courseId       String?                 @db.Uuid
  teacherId      String?                 @db.Uuid

  date           DateTime
  startTime      DateTime?
  endTime        DateTime?

  status         AttendanceSessionStatus @default(SCHEDULED)

  openedAt       DateTime?
  closedAt       DateTime?

  takenById      String?                 @db.Uuid
  notes          String?

  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  institute      Institute               @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  calendar       AttendanceCalendar?     @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear?           @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  classGroup     ClassGroup?             @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  section        Section?                @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject        Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  course         Course?                 @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacher        TeacherProfile?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  takenByUser    User?                   @relation("AttendanceTakenByUser", fields: [takenById], references: [id], onDelete: SetNull)

  records        AttendanceRecord[]

  @@map("attendance_sessions")
  @@index([instituteId, date])
  @@index([classGroupId, sectionId, date])
  @@index([calendarId, date])
}

model AttendanceRecord {
  id             String            @id @default(uuid()) @db.Uuid

  sessionId      String            @db.Uuid
  studentId      String            @db.Uuid
  instituteId    String            @db.Uuid

  status         AttendanceStatus  // PRESENT, ABSENT, LATE, EXCUSED, LEAVE, HALF_DAY

  checkInAt      DateTime?
  checkOutAt     DateTime?

  markedById     String?           @db.Uuid
  markedAt       DateTime          @default(now())

  modifiedById   String?           @db.Uuid
  modifiedAt     DateTime?
  overrideReason String?

  remarks        String?

  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institute      Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  markedByUser   User?             @relation("AttendanceMarkedByUser", fields: [markedById], references: [id], onDelete: SetNull)
  modifiedByUser User?             @relation("AttendanceModifiedByUser", fields: [modifiedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@map("attendance_records")
  @@index([instituteId, status])
  @@index([instituteId, studentId])
  @@index([studentId, status])
  @@index([sessionId])
}

// ------------------------------------------
// 4. TIMETABLES & LIVE SESSIONS
// ------------------------------------------

model ClassRoutine {
  id           String          @id @default(uuid()) @db.Uuid

  instituteId  String          @db.Uuid
  classGroupId String          @db.Uuid
  sectionId    String?         @db.Uuid

  subjectId    String?         @db.Uuid
  teacherId    String?         @db.Uuid
  courseId     String?         @db.Uuid

  dayOfWeek    Int             // 0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday, 6=Saturday

  startTime    DateTime
  endTime      DateTime

  room         String?

  validFrom    DateTime?
  validUntil   DateTime?

  status       RecordStatus    @default(ACTIVE)

  institute    Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classGroup   ClassGroup      @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  section      Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject      Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher      TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  course       Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("class_routines")
  @@index([classGroupId, sectionId])
  @@index([teacherId])
  @@index([instituteId])
}

model LiveClass {
  id             String          @id @default(uuid()) @db.Uuid

  instituteId    String          @db.Uuid
  courseId       String          @db.Uuid
  teacherId      String?         @db.Uuid

  title          String
  provider       String?

  meetingUrl     String?
  meetingId      String?
  passcode       String?

  scheduledStart DateTime
  scheduledEnd   DateTime?

  recordingUrl   String?

  status         RecordStatus    @default(ACTIVE)
  metadata       Json?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  institute      Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher        TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@map("live_classes")
  @@index([courseId, scheduledStart])
  @@index([instituteId])
}
