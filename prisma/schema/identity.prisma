// ==========================================
// IDENTITY, AUTHENTICATION & RBAC DOMAIN
// ==========================================

model User {
  id               String      @id @default(uuid()) @db.Uuid

  email            String?     @unique
  phone            String?     @unique

  passwordHash     String?

  firstName        String
  middleName       String?
  lastName         String?

  displayName      String?

  avatarUrl        String?

  status           UserStatus  @default(INVITED)

  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?

  lastLoginAt      DateTime?
  lastActiveAt     DateTime?

  twoFactorEnabled Boolean     @default(false)

  metadata         Json?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  // Relations
  memberships      InstituteMembership[]
  roles            UserRole[]

  // Polymorphic profile linkages (1 User -> 1 optional profile per persona)
  student          Student?
  teacher          TeacherProfile?
  guardian         Guardian?
  staff            StaffProfile?

  // Result Override & Approval tracking
  overriddenResults          StudentResult[]   @relation("ResultOverriddenByUser")
  approvedResults            StudentResult[]   @relation("ResultApprovedByUser")
  overriddenResultComponents ResultComponent[] @relation("ComponentOverriddenByUser")

  // Attendance Creator, Taker & Audit Tracking
  createdAttendanceCalendars AttendanceCalendar[] @relation("CalendarCreatedByUser")
  takenAttendanceSessions    AttendanceSession[]  @relation("AttendanceTakenByUser")
  markedAttendanceRecords    AttendanceRecord[]   @relation("AttendanceMarkedByUser")
  modifiedAttendanceRecords  AttendanceRecord[]   @relation("AttendanceModifiedByUser")
  // LMS & Course Restriction Tracking
  createdAccessOverrides     LearningItemAccessOverride[] @relation("AccessOverrideCreatedByUser")
  createdCourseRestrictions  CourseAccessRestriction[]    @relation("CourseRestrictionCreatedByUser")
  revokedCourseRestrictions  CourseAccessRestriction[]    @relation("CourseRestrictionRevokedByUser")

  // System Activity
  notifications    Notification[]
  auditLogs        AuditLog[]
  permissionOverrides        UserPermissionOverride[]     @relation("UserPermissionOverrides")
  createdPermissionOverrides UserPermissionOverride[]     @relation("UserPermissionOverridesCreatedBy")
  verifiedStudentDocs        StudentDocument[]            @relation("StudentDocVerifiedBy")
  verifiedTeacherQuals       TeacherQualification[]       @relation("TeacherQualVerifiedBy")
  verifiedStaffDocs          StaffDocument[]              @relation("StaffDocVerifiedBy")

  // Support System
  assignedSupportTickets     SupportTicket[]              @relation("AssignedSupportTickets")
  supportTicketMessages      SupportTicketMessage[]
  supportAvailabilitySlots   SupportAvailabilitySlot[]
  hostedSupportSessions      SupportSession[]             @relation("HostedSupportSessions")

  // Notice System
  noticeReads                NoticeRead[]

  // Security & Settings
  twoFactorSecret            String?
  twoFactorBackupCodes       String[]                     @default([])
  settings                   UserSetting?
  sessions                   UserSession[]

  // Events & Analytics
  analyticsEvents            AnalyticsEvent[]             @relation("AnalyticsEventActor")

  @@map("users")
  @@index([status])
  @@index([email])
  @@index([phone])
}

model UserSetting {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  language          String   @default("en")
  theme             String   @default("SYSTEM")
  timezone          String   @default("UTC")
  notificationPrefs Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
  @@index([userId])
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  token        String?   @db.Text
  ipAddress    String?
  userAgent    String?
  device       String?
  isRevoked    Boolean   @default(false)
  expiresAt    DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
  @@index([userId])
  @@index([isRevoked])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid

  instituteId String?  @db.Uuid

  name        String
  code        String
  description String?

  isSystem    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  users       UserRole[]

  @@unique([instituteId, code])
  @@map("roles")
  @@index([instituteId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid

  resource    String
  action      String

  description String?

  createdAt   DateTime @default(now())

  roles         RolePermission[]
  userOverrides UserPermissionOverride[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String          @db.Uuid
  permissionId String          @db.Uuid

  scope        PermissionScope @default(OWN)

  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model InstituteMembership {
  id          String           @id @default(uuid()) @db.Uuid

  instituteId String           @db.Uuid
  userId      String           @db.Uuid

  status      MembershipStatus @default(ACTIVE)

  joinedAt    DateTime         @default(now())
  leftAt      DateTime?

  metadata    Json?

  institute   Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instituteId, userId])
  @@map("institute_memberships")
  @@index([userId])
  @@index([instituteId, status])
}

model UserPermissionOverride {
  id           String          @id @default(uuid()) @db.Uuid

  instituteId  String          @db.Uuid
  userId       String          @db.Uuid
  permissionId String          @db.Uuid

  effect       OverrideEffect
  scope        PermissionScope @default(OWN)

  expiresAt    DateTime?
  reason       String?
  createdById  String?         @db.Uuid

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  institute    Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user         User            @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation("UserPermissionOverridesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([instituteId, userId, permissionId])
  @@index([instituteId, userId])
  @@map("user_permission_overrides")
}
